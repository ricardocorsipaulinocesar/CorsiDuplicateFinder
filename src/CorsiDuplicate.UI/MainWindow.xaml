<Window x:Class="CorsiDuplicate.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CorsiDuplicate.UI"
        xmlns:vm="clr-namespace:CorsiDuplicate.UI.ViewModels"
        xmlns:conv="clr-namespace:CorsiDuplicate.UI.Converters"
        xmlns:ctl="clr-namespace:CorsiDuplicate.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1180"
        Icon="app.ico"
        Background="#15171C">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Resources/Icons.xaml"/>
            <ResourceDictionary Source="Resources/ScrollBars.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- Dark theme palette -->
        <SolidColorBrush x:Key="BgApp" Color="#15171C"/>
        <SolidColorBrush x:Key="Surface" Color="#1E2128"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#252932"/>
        <SolidColorBrush x:Key="Border" Color="#333844"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#454C5B"/>
        <SolidColorBrush x:Key="Text" Color="#E8EAEF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA1AD"/>
        <SolidColorBrush x:Key="Accent" Color="#6690F2"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#25324F"/>
        <SolidColorBrush x:Key="AccentStrong" Color="#8CAAF5"/>
        <SolidColorBrush x:Key="Success" Color="#3FCA80"/>
        <SolidColorBrush x:Key="SuccessSoft" Color="#1E3327"/>
        <SolidColorBrush x:Key="Danger" Color="#EA6F64"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#3A2426"/>

        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:BoolToDoubleConverter x:Key="ChevronAngle" TrueValue="90" FalseValue="0"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:StringToBrushConverter x:Key="StringToBrush"/>
        <conv:RowHeightFromThumbConverter x:Key="RowHeightFromThumb"/>
        <conv:FilmstripWidthConverter x:Key="FilmstripWidth"/>

        <Style TargetType="Thumb" x:Key="ColumnResizeThumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" HorizontalAlignment="Right" Width="8">
                            <Rectangle Width="2" Fill="{StaticResource BorderStrong}" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Button" x:Key="HqButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Button" x:Key="LqButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <!-- Bold, borderless clickable text used for every results filter/action label
             ("High/Low quality (all)", "Clean results", "Close all", the "Thumb" sort
             header) — a subtle highlight on hover is the only affordance, so the label
             itself (not a button box around it) reads as the control. -->
        <Style TargetType="Button" x:Key="FilterLabel">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <!-- A named TextBlock (instead of a plain ContentPresenter) so the
                                 IsMouseOver trigger below can underline it directly — the
                                 underline is what marks this label as clickable, matching
                                 the "Thumb" header and every per-set column header. -->
                            <TextBlock x:Name="LabelText" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="LabelText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="FilterLabelHq" BasedOn="{StaticResource FilterLabel}">
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
        </Style>
        <Style TargetType="Button" x:Key="FilterLabelLq" BasedOn="{StaticResource FilterLabel}">
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
        </Style>
        <Style TargetType="Button" x:Key="FilterLabelNeutral" BasedOn="{StaticResource FilterLabel}">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- Rounded, always-filled pill — used for "High quality (all)", "Low quality
             (all)", "Clean results" and "Close all" in the main toolbar. Unlike
             FilterLabel above (a link: transparent until hovered), a pill's fill is
             visible at rest so it reads as a button without needing a hover. -->
        <Style TargetType="Button" x:Key="Pill">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15">
                            <!-- A fixed radius (not an arbitrarily large one) is required here: unlike
                                 CSS border-radius, WPF's CornerRadius does not clamp an oversized value
                                 down to half the shorter side — it instead stretches into a full ellipse
                                 (rx=width/2, ry=height/2), losing the straight top/bottom edges that make
                                 this read as a pill/stadium shape rather than an oval. 15 sits just under
                                 half this button's own rendered height (~30px), which keeps both corners
                                 circular with a flat run between them regardless of the button's width.

                                 A translucent white overlay brightens the pill on hover/press, the same
                                 way regardless of each variant's own fill color — matching the mock's
                                 filter:brightness(1.12) hover look instead of fading toward transparent. -->
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <Border x:Name="HoverOverlay" CornerRadius="15" Background="Transparent"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="PillHq" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Setter Property="BorderBrush" Value="#593FCA80"/>
        </Style>
        <Style TargetType="Button" x:Key="PillLq" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="#59EA6F64"/>
        </Style>
        <Style TargetType="Button" x:Key="PillNeutral" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
        </Style>
        <Style TargetType="Button" x:Key="PillDanger" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="#59EA6F64"/>
        </Style>
        <Style TargetType="Button" x:Key="PillPrimary" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style TargetType="Button" x:Key="PillDelete" BasedOn="{StaticResource Pill}">
            <Setter Property="Background" Value="{StaticResource Danger}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Danger}"/>
        </Style>

        <!-- One small link per field in a folder's "Filter all results by:" row — same
             bold/underline-on-hover language as FilterLabel, smaller, muted at rest since
             there are nine of them per folder. Each usage adds its own DataTrigger on
             ActiveFolderFilter (see the folder DataTemplate) to highlight when active,
             since the trigger's Value differs per button. -->
        <Style TargetType="Button" x:Key="FolderFilterLink">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="LabelText" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                       FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                                <Setter TargetName="LabelText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MiniButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Flat cell inside the unified thumbnails stepper — no border/radius of its
             own (the stepper's outer Border supplies both), background brightens on
             hover/press, matching the mock's plain "-"/"+" stepper cells. -->
        <Style TargetType="Button" x:Key="StepperButton">
            <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentStrong}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <conv:AllEqualConverter x:Key="AllEqual"/>

        <!-- Scan mode tile: highlighted while it is the active mode (Tag holds the mode name). -->
        <Style x:Key="ModeTile" TargetType="Button" BasedOn="{StaticResource IconTile}">
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource AllEqual}">
                            <Binding Path="ScanMode"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource IconTileSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="#8CAAF5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sort chip of a folder: highlighted while it is the folder's active filter (Tag = filter name). -->
        <Style x:Key="SortChip" TargetType="Button" BasedOn="{StaticResource IconChip}">
            <Setter Property="Foreground" Value="{StaticResource Ink.Sky}"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource AllEqual}">
                            <Binding Path="ActiveFolderFilter"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource IconTileSelectedBrush}"/>
                    <Setter Property="BorderBrush" Value="#8CAAF5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <!-- Taskbar button: overall progress of the scan, thumbnails or delete (also shown minimized). -->
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressState="{Binding TaskbarState}" ProgressValue="{Binding TaskbarProgress}"/>
    </Window.TaskbarItemInfo>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- toolbar -->
            <RowDefinition Height="Auto"/> <!-- scan progress hairline -->
            <RowDefinition Height="Auto"/> <!-- folder panel -->
            <RowDefinition Height="*"/>    <!-- results -->
            <RowDefinition Height="Auto"/> <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
                <Button Style="{StaticResource IconTilePrimary}" ctl:Icon.Data="{StaticResource Icon.Scan}" Foreground="{StaticResource Ink.Blue}"
                        ToolTip="Scan folders: look for duplicates in the enabled folders"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"/>
                <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.Stop}" Foreground="{StaticResource Ink.Red}" Margin="8,0,0,0"
                        ToolTip="Stop the scan in progress"
                        Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}"/>

                <Border Width="1" Background="{StaticResource Border}" Margin="12,2,12,2"/>
                <!-- Scan mode: All = photos and videos into duplicate Sets; Videos = skip photos;
                     Videos+Contained = skip photos and run the Contained analysis per folder. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}">
                    <Button Style="{StaticResource ModeTile}" Tag="All" ctl:Icon.Data="{StaticResource Icon.All}" Foreground="{StaticResource Ink.Sky}"
                            Command="{Binding SetScanModeCommand}" CommandParameter="All"
                            ToolTip="All: photos and videos, looks for duplicates"/>
                    <Button Style="{StaticResource ModeTile}" Tag="Videos" ctl:Icon.Data="{StaticResource Icon.Videos}" Foreground="{StaticResource Ink.Blue}"
                            Command="{Binding SetScanModeCommand}" CommandParameter="Videos"
                            ToolTip="Videos: skips photos and looks only for duplicate videos"/>
                    <Button Style="{StaticResource ModeTile}" Tag="VideosContained" ctl:Icon.Data="{StaticResource Icon.Contained}" Foreground="{StaticResource Ink.Violet}"
                            Command="{Binding SetScanModeCommand}" CommandParameter="VideosContained"
                            ToolTip="Videos + Contained: skips photos and, in each folder, compares every video with the others (ignores the similarity filter) to find excerpts and compilations"/>
                </StackPanel>
                <Border Width="1" Background="{StaticResource Border}" Margin="8,2,12,2"/>

                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,0"
                        VerticalAlignment="Stretch" Margin="0,0,8,0"
                        IsEnabled="{Binding IsSimilarityEnabled}"
                        ToolTipService.ShowOnDisabled="True"
                        ToolTip="Similarity: the minimum match for files to be grouped as duplicates (60-100%)">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                    <Setter Property="ToolTip" Value="Not used in Videos + Contained: every video in the folder is compared"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Icon.Sim}" Stroke="{StaticResource Ink.Amber}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                        <Slider x:Name="SimSlider" Minimum="60" Maximum="100" Width="70" Margin="8,0,0,0" VerticalAlignment="Center"
                                Value="{Binding SimilarityThreshold, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding SimilarityThreshold, StringFormat={}{0:0}%}" FontWeight="Bold" Foreground="{StaticResource AccentStrong}"
                                   Width="34" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Status: pulses bold/green while anything slow is running (scan, regroup, sort, thumbnails), so the
                     app visibly reads as "working" instead of looking identical to any
                     other status message; reverts to the normal muted style once
                     finished/stopped. -->
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="12,5" MinWidth="120" ToolTip="What the app is doing right now">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="StatusPulseStoryboard">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.55" Duration="0:0:0.7"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="StatusPulseStoryboard"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Ellipse Width="7" Height="7" Fill="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,7,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Success}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </StackPanel>
                </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Scan progress: a thin hairline, visible only while a scan is running. -->
        <ProgressBar Grid.Row="1" Height="3" BorderThickness="0" Background="{StaticResource Border}" Foreground="{StaticResource Accent}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Minimum="0" Maximum="{Binding ScanProgressTotal}" Value="{Binding ScanProgressCurrent}"/>

        <!-- Folder manager panel -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.Folder}" Foreground="{StaticResource Ink.Amber}"
                                Command="{Binding FolderManager.ToggleManageFoldersCommand}"
                                ToolTip="Folders: open the list to add, enable or remove folders"/>

                        <Border Width="1" Background="{StaticResource Border}" Margin="12,2" Height="20"/>
                        <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.QualityHigh}" Foreground="{StaticResource Ink.Green}"
                                Command="{Binding ApplyHighQualityToAllCommand}"
                                ToolTip="High quality: in every duplicate set across every folder, keep only the best copy unchecked"/>
                        <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.QualityLow}" Foreground="{StaticResource Ink.Red}" Margin="6,0,0,0"
                                Command="{Binding ApplyLowQualityToAllCommand}"
                                ToolTip="Low quality: in every duplicate set across every folder, keep only the worst copy unchecked"/>

                        <Border Width="1" Background="{StaticResource Border}" Margin="12,2" Height="20"/>
                        <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.ListClear}" Foreground="{StaticResource Ink.Cyan}"
                                Command="{Binding ClearResultsCommand}"
                                ToolTip="Clean results: clear every duplicate set currently shown, without re-scanning"/>
                        <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.Collapse}" Foreground="{StaticResource Ink.Blue}" Margin="6,0,0,0"
                                Command="{Binding CollapseAllFoldersCommand}"
                                ToolTip="Collapse all: close every expanded folder, without clearing any results"/>

                        <Border Width="1" Background="{StaticResource Border}" Margin="10,2" Height="20"/>
                        <Grid>
                            <Button x:Name="ThumbnailsMenuButton" Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.Film}" Foreground="{StaticResource Ink.Pink}"
                                    Command="{Binding ToggleThumbnailsMenuCommand}"
                                    ToolTip="{Binding ThumbnailsPerVideo, StringFormat=Thumbnails per video: {0} (click to change)}"/>
                            <Popup IsOpen="{Binding IsThumbnailsMenuOpen}" StaysOpen="False" AllowsTransparency="True"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=ThumbnailsMenuButton}" VerticalOffset="6">
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                        CornerRadius="10" Padding="14" Width="260">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="24" ShadowDepth="6"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="THUMBNAILS PER VIDEO" FontSize="10.5" FontWeight="Bold"
                                                   Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ThumbnailsPerVideo}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                            <!-- One unified rounded stepper (border around the whole
                                                 group), not three separate buttons — matches the mock. -->
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderStrong}" BorderThickness="1"
                                                    CornerRadius="8" ClipToBounds="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="&#8722;" Width="28" Height="28" Style="{StaticResource StepperButton}" ToolTip="Fewer thumbnails per video"
                                                            Command="{Binding DecrementThumbnailsPerVideoCommand}"/>
                                                    <TextBlock Text="{Binding ThumbnailsPerVideo}" Width="34" TextAlignment="Center"
                                                               FontSize="13" FontWeight="Bold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                                    <Button Content="&#43;" Width="28" Height="28" Style="{StaticResource StepperButton}" ToolTip="More thumbnails per video"
                                                            Command="{Binding IncrementThumbnailsPerVideoCommand}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock TextWrapping="Wrap" FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0">
                                            Com 1, pega sempre o início do vídeo. A partir de 2, calibra entre início, meio e fim — a mesma proporção em todos os resultados. Fica salvo para as próximas vezes.
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Results: one collapsible node per folder -->
        <ScrollViewer Grid.Row="3" Padding="16" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgApp}">
            <StackPanel>
                <TextBlock Text="No duplicates found yet. Open the folder list (folder icon) to add folders, then press the scan icon."
                           Visibility="{Binding HasAnyResults, Converter={StaticResource BoolToVisInverted}}"
                           Foreground="{StaticResource TextMuted}" Margin="8,40" HorizontalAlignment="Center" FontSize="13"/>

                <ItemsControl ItemsSource="{Binding FolderResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Folder node header: click anywhere to toggle expand/collapse -->
                                    <Border Background="{StaticResource SurfaceAlt}" Padding="12,10" Cursor="Hand"
                                            CornerRadius="8,8,0,0"
                                            MouseLeftButtonUp="FolderHeader_MouseLeftButtonUp">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#9656;" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ChevronAngle}}"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Path}" FontWeight="Bold" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                <Run Text=" files scanned"/>
                                            </TextBlock>
                                            <Border Background="{StaticResource AccentSoft}" BorderThickness="0" CornerRadius="10" Padding="8,1" Margin="10,0,0,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentStrong}">
                                                    <Run Text="{Binding Groups.Count, Mode=OneWay}"/>
                                                    <Run Text=" duplicate set(s)"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Folder-wide filter row: unlike the column headers inside each
                                         Set below (which only sort that one Set's own grid), every
                                         filter here ignores Set boundaries and reorders every result
                                         in this folder — and only this folder — as one flat list.
                                         Clicking the active one again restores the original Sets;
                                         clicking a different one switches straight to it. -->
                                    <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,7">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="FILTER ALL RESULTS BY:" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                            <!-- One icon chip per field. Each carries one fixed direction; the active one is highlighted. -->
                                            <Button Style="{StaticResource SortChip}" Tag="Thumb" ctl:Icon.Data="{StaticResource Icon.Image}" Click="FolderFilter_Click"
                                                    ToolTip="Thumb: sort all results in this folder by thumbnail visual similarity"/>
                                            <Button Style="{StaticResource SortChip}" Tag="File" ctl:Icon.Data="{StaticResource Icon.File}" Click="FolderFilter_Click"
                                                    ToolTip="File: sort all results in this folder by file name (A to Z)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Size" ctl:Icon.Data="{StaticResource Icon.Size}" Click="FolderFilter_Click"
                                                    ToolTip="Size: sort all results in this folder by file size (largest first)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Length" ctl:Icon.Data="{StaticResource Icon.Clock}" Click="FolderFilter_Click"
                                                    ToolTip="Length: sort all results in this folder by duration (longest first)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Resolution" ctl:Icon.Data="{StaticResource Icon.Resolution}" Click="FolderFilter_Click"
                                                    ToolTip="Resolution: sort all results in this folder by resolution (highest first)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Bit rate" ctl:Icon.Data="{StaticResource Icon.Bars}" Click="FolderFilter_Click"
                                                    ToolTip="Bit rate: sort all results in this folder by bit rate (highest first)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Audio" ctl:Icon.Data="{StaticResource Icon.Sound}" Click="FolderFilter_Click"
                                                    ToolTip="Audio: sort all results in this folder by audio sample rate (highest first)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Match" ctl:Icon.Data="{StaticResource Icon.Match}" Click="FolderFilter_Click"
                                                    ToolTip="Match: sort all results in this folder by match % (highest first)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Hash" ctl:Icon.Data="{StaticResource Icon.Hash}" Click="FolderFilter_Click"
                                                    ToolTip="Hash: sort all results in this folder by hash (A to Z)"/>
                                            <Button Style="{StaticResource SortChip}" Tag="Contained" ctl:Icon.Data="{StaticResource Icon.Contained}" Foreground="{StaticResource Ink.Violet}" Click="FolderFilter_Click"
                                                    ToolTip="Contained: find videos in this folder that are an excerpt of another, longer video (click again to go back)"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="10,10,10,10">
                                        <!-- The Sets are only built while the folder is expanded: a collapsed folder
                                             used to create every Set's grid and rows anyway (just hidden). -->
                                        <ItemsControl ItemsSource="{Binding VisibleGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="8,8,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,1" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding SetLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentStrong}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding SetMeta}" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                                                                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                                                      GridLinesVisibility="Horizontal" IsReadOnly="False"
                                                                      Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
                                                                      BorderThickness="0" RowBackground="{StaticResource Surface}"
                                                                      HorizontalGridLinesBrush="{StaticResource Border}"
                                                                      RowHeight="{Binding DataContext.ThumbnailColumnWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RowHeightFromThumb}}"
                                                                      EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto"
                                                                      PreviewMouseWheel="ResultsDataGrid_PreviewMouseWheel">
                                                                <DataGrid.Resources>
                                                                    <!-- These headers already sort the grid on click (default DataGrid
                                                                         behavior) but looked like plain labels; bold + hand cursor +
                                                                         an accent-colored hover state now mark them as clickable, the
                                                                         same "this can be clicked" language used by "Thumb" and every
                                                                         toolbar filter. -->
                                                                    <Style TargetType="DataGridColumnHeader">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                                        <Setter Property="Padding" Value="8,6"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AccentStrong}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </DataGrid.Resources>
                                                                <DataGrid.RowStyle>
                                                                    <Style TargetType="DataGridRow">
                                                                        <Setter Property="Background" Value="{Binding HashGroupColor, Converter={StaticResource StringToBrush}}"/>
                                                                    </Style>
                                                                </DataGrid.RowStyle>
                                                                <DataGrid.CellStyle>
                                                                    <Style TargetType="DataGridCell">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                                    </Style>
                                                                </DataGrid.CellStyle>
                                                                <DataGrid.Columns>
                                                                    <DataGridTemplateColumn Header="" Width="34">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Mark this file for deletion"
                                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>

                                                                    <DataGridTemplateColumn>
                                                                        <DataGridTemplateColumn.HeaderTemplate>
                                                                            <DataTemplate>
                                                                                <Grid>
                                                                                    <!-- Static now — filtering the whole folder by thumbnail
                                                                                         similarity moved to the folder's own "Filter all results
                                                                                         by:" row (Thumb button there), since that behavior always
                                                                                         acted at folder scope, never per-Set, and this column has
                                                                                         no bound value to sort a single Set by anyway. -->
                                                                                    <TextBlock Text="Thumb" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                                                    <Thumb Style="{StaticResource ColumnResizeThumb}" HorizontalAlignment="Right"
                                                                                           DragDelta="ThumbnailResizeThumb_DragDelta"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.HeaderTemplate>
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="{StaticResource SurfaceAlt}" CornerRadius="4" Margin="4"
                                                                                        Height="{Binding DataContext.ThumbnailColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        Cursor="Hand" Loaded="ThumbnailCell_Loaded" ToolTip="Click to open a preview"
                                                                                        MouseLeftButtonUp="ThumbnailBorder_MouseLeftButtonUp">
                                                                                    <Border.Width>
                                                                                        <MultiBinding Converter="{StaticResource FilmstripWidth}">
                                                                                            <Binding Path="DataContext.ThumbnailColumnWidth" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                                            <Binding Path="Thumbnails.Count"/>
                                                                                        </MultiBinding>
                                                                                    </Border.Width>
                                                                                    <Grid>
                                                                                        <!-- One or more thumbnails side by side (a video filmstrip
                                                                                             when "Thumbnails per video" > 1, otherwise a single
                                                                                             image just like a photo) sharing this fixed-size box. -->
                                                                                        <ItemsControl ItemsSource="{Binding Thumbnails}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <UniformGrid Rows="1"/>
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                        <Border Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                                                                                                Background="#33000000">
                                                                                            <TextBlock Text="▶" Foreground="White" FontSize="20"
                                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding DurationDisplay}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                                                                                                   Foreground="White" Background="#99000000" FontSize="10" Padding="3,1"
                                                                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>

                                                                    <DataGridTemplateColumn Header="File" Width="2*">
                                                                        <DataGridTemplateColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by file name"/>
                                                                            </Style>
                                                                        </DataGridTemplateColumn.HeaderStyle>
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <Border Margin="{Binding ContainmentIndent}" BorderThickness="{Binding ContainmentRule}"
                                                                                        BorderBrush="{Binding ContainmentAccent, Converter={StaticResource StringToBrush}}" Padding="4,0" VerticalAlignment="Center">
                                                                                <StackPanel VerticalAlignment="Center">
                                                                                    <Border CornerRadius="8" Padding="7,1" Margin="0,2,0,3" HorizontalAlignment="Left"
                                                                                            Background="{Binding ContainmentRoleColor, Converter={StaticResource StringToBrush}}"
                                                                                            Visibility="{Binding HasContainmentRole, Converter={StaticResource BoolToVis}}">
                                                                                        <TextBlock Text="{Binding ContainmentRole}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                                                    </Border>
                                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"/>
                                                                                    <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                                                    <TextBlock Text="{Binding ContainmentNote}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"
                                                                                               Foreground="{Binding ContainmentColor, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap"
                                                                                               Visibility="{Binding HasContainmentNote, Converter={StaticResource BoolToVis}}"/>
                                                                                    <TextBlock Text="{Binding SelectionNote}" FontSize="11" FontWeight="Bold" Margin="0,3,0,0"
                                                                                               Foreground="{Binding SelectionNoteColor, Converter={StaticResource StringToBrush}}" TextWrapping="Wrap"
                                                                                               Visibility="{Binding HasSelectionNote, Converter={StaticResource BoolToVis}}"/>
                                                                                    <Border Width="220" Height="6" CornerRadius="3" Background="{StaticResource Border}"
                                                                                            HorizontalAlignment="Left" Margin="0,5,0,0"
                                                                                            Visibility="{Binding HasContainmentBars, Converter={StaticResource BoolToVis}}">
                                                                                        <ItemsControl ItemsSource="{Binding ContainmentBars}">
                                                                                            <ItemsControl.ItemsPanel>
                                                                                                <ItemsPanelTemplate>
                                                                                                    <Grid/>
                                                                                                </ItemsPanelTemplate>
                                                                                            </ItemsControl.ItemsPanel>
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate>
                                                                                                    <Border CornerRadius="3" HorizontalAlignment="Left" Height="6"
                                                                                                            Width="{Binding Width}" Margin="{Binding Margin}"
                                                                                                            Background="{Binding Color, Converter={StaticResource StringToBrush}}"/>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>
                                                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80" IsReadOnly="True">
                                                                        <DataGridTextColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by file size"/>
                                                                            </Style>
                                                                        </DataGridTextColumn.HeaderStyle>
                                                                    </DataGridTextColumn>
                                                                    <DataGridTextColumn Header="Length" Binding="{Binding DurationDisplay}" Width="60" IsReadOnly="True">
                                                                        <DataGridTextColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by duration"/>
                                                                            </Style>
                                                                        </DataGridTextColumn.HeaderStyle>
                                                                    </DataGridTextColumn>
                                                                    <DataGridTextColumn Header="Resolution" Binding="{Binding ResolutionDisplay}" Width="90" IsReadOnly="True">
                                                                        <DataGridTextColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by resolution"/>
                                                                            </Style>
                                                                        </DataGridTextColumn.HeaderStyle>
                                                                    </DataGridTextColumn>
                                                                    <DataGridTextColumn Header="Bit rate" Binding="{Binding BitRateDisplay}" Width="80" IsReadOnly="True">
                                                                        <DataGridTextColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by bit rate"/>
                                                                            </Style>
                                                                        </DataGridTextColumn.HeaderStyle>
                                                                    </DataGridTextColumn>
                                                                    <DataGridTextColumn Header="Audio" Binding="{Binding AudioDisplay}" Width="80" IsReadOnly="True">
                                                                        <DataGridTextColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by audio sample rate"/>
                                                                            </Style>
                                                                        </DataGridTextColumn.HeaderStyle>
                                                                    </DataGridTextColumn>
                                                                    <DataGridTextColumn Header="Match" Binding="{Binding MatchDisplay}" Width="70" IsReadOnly="True">
                                                                        <DataGridTextColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by match %"/>
                                                                            </Style>
                                                                        </DataGridTextColumn.HeaderStyle>
                                                                    </DataGridTextColumn>
                                                                    <DataGridTextColumn Header="Hash" Binding="{Binding HashHex}" Width="110" IsReadOnly="True">
                                                                        <DataGridTextColumn.HeaderStyle>
                                                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                                                <Setter Property="ToolTip" Value="Click to sort by hash"/>
                                                                            </Style>
                                                                        </DataGridTextColumn.HeaderStyle>
                                                                    </DataGridTextColumn>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Footer close bar: same collapse action as the header, so a long
                                             folder's duplicate sets can be closed without scrolling back up. -->
                                        <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                                                Padding="12,8" Cursor="Hand" CornerRadius="0,0,8,8" Margin="-10,10,-10,-10"
                                                MouseLeftButtonUp="FolderHeader_MouseLeftButtonUp">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#9652;" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center">
                                                    <Run Text="Close &quot;"/>
                                                    <Run Text="{Binding Path, Mode=OneWay}"/>
                                                    <Run Text="&quot;"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontWeight="Black" FontSize="15" Foreground="{StaticResource AccentStrong}" Text="{Binding Selection.SelectedCount}"/>
                    <TextBlock Text=" selected" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,16,1"/>
                    <TextBlock FontWeight="Black" FontSize="15" Foreground="{StaticResource AccentStrong}" Text="{Binding Selection.TotalSelectedDisplay}"/>
                    <TextBlock Text=" total size" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.Trash}" Foreground="{StaticResource Ink.Red}"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding Selection.HasSelection}"
                        ToolTip="Move every checked file to the Recycle Bin"/>
            </Grid>
        </Border>

        <!-- Delete progress: modal over the whole window while files are moved to the Recycle
             Bin (the taskbar button shows the same progress). -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#B3000000"
                Visibility="{Binding IsDeleting, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Excluindo arquivos…" Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding DeleteProgressText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DeleteCurrentFile, Mode=OneWay}"/>
                    </TextBlock>
                    <ProgressBar Height="6" Margin="0,6,0,0" BorderThickness="0" Background="{StaticResource Border}"
                                 Foreground="{StaticResource Success}" Minimum="0" Maximum="{Binding DeleteProgressTotal}"
                                 Value="{Binding DeleteProgressCurrent, Mode=OneWay}"/>
                    <TextBlock Text="{Binding DeleteBytesText}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0"/>
                    <Button Content="Cancelar" Style="{StaticResource PillDanger}" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Command="{Binding CancelDeleteCommand}"
                            ToolTip="Stop after the file being moved now; files already deleted stay in the Recycle Bin"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Managed folders: full-screen overlay. Covers every row so it sits above the
             whole window; clicking the dark backdrop closes it, clicking the sheet itself
             does not (the sheet's own MouseLeftButtonDown is marked handled below). -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#B3000000"
                Visibility="{Binding FolderManager.IsManageFoldersOpen, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonDown="ManageFoldersBackdrop_MouseLeftButtonDown">
            <Border Background="{StaticResource BgApp}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Margin="28" MouseLeftButtonDown="ManageFoldersSheet_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="20,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Managed folders" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5">
                                        <Run Text="{Binding FolderManager.Folders.Count, Mode=OneWay}"/>
                                        <Run Text=" folder(s) tracked · click outside this panel to close"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Button Style="{StaticResource IconChip}" ctl:Icon.Data="{StaticResource Icon.Close}" Foreground="{StaticResource Ink.Red}" Margin="0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding FolderManager.CloseManageFoldersCommand}"
                                    ToolTip="Close the folders list"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding FolderManager.Folders}" BorderThickness="0" Background="{StaticResource BgApp}">
                        <ListView.Resources>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                                            <Border x:Name="Row" Background="{TemplateBinding Background}" Padding="2,3" SnapsToDevicePixels="True">
                                                <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                      Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#1AFFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoft}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            </Style>
                            <Style x:Key="SortableFolderHeader" TargetType="{x:Type GridViewColumnHeader}"
                                   BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentStrong}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="40">
                                    <GridViewColumn.Header>
                                        <CheckBox IsChecked="{Binding FolderManager.AllFoldersEnabled, Mode=TwoWay}"
                                                  ToolTip="Select or unselect every folder for the scan"/>
                                    </GridViewColumn.Header>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" ToolTip="Include this folder when scanning"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="330" DisplayMemberBinding="{Binding Path}">
                                    <GridViewColumnHeader Content="{Binding FolderManager.PathHeader}" Style="{StaticResource SortableFolderHeader}"
                                                          Command="{Binding FolderManager.SortByCommand}" CommandParameter="Path"
                                                          ToolTip="Click to sort by folder path"/>
                                </GridViewColumn>
                                <GridViewColumn Width="200">
                                    <GridViewColumnHeader Content="{Binding FolderManager.LastModifiedHeader}" Style="{StaticResource SortableFolderHeader}"
                                                          Command="{Binding FolderManager.SortByCommand}" CommandParameter="LastModified"
                                                          ToolTip="Click to sort by the most recent change inside each folder"/>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LastModifiedDisplay}"/>
                                                <TextBlock Text="{Binding LastModifiedRelative}" Foreground="{StaticResource TextMuted}"
                                                           FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <!-- Own column for the change badges, so they are never cut off by the date column. -->
                                <GridViewColumn Header="Changes" Width="270">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#1F2B45" BorderBrush="#8CAAF5" BorderThickness="1" CornerRadius="9"
                                                        Padding="8,1" Margin="0,0,6,0" VerticalAlignment="Center"
                                                        ToolTip="Modified after the app was last opened"
                                                        Visibility="{Binding IsChangedSinceLastOpen, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="changed since last open" FontSize="11" FontWeight="Bold" Foreground="#8CAAF5"/>
                                                </Border>
                                                <Border Background="#3A3020" BorderBrush="#66E8B34B" BorderThickness="1" CornerRadius="9"
                                                        Padding="8,1" VerticalAlignment="Center"
                                                        ToolTip="Modified after the last scan — scan again to pick up the changes"
                                                        Visibility="{Binding IsChangedSinceScan, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="changed since scan" FontSize="11" FontWeight="Bold" Foreground="#E8B34B"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding LastScannedDisplay}">
                                    <GridViewColumnHeader Content="{Binding FolderManager.LastScannedHeader}" Style="{StaticResource SortableFolderHeader}"
                                                          Command="{Binding FolderManager.SortByCommand}" CommandParameter="LastScanned"
                                                          ToolTip="Click to sort by last scan time"/>
                                </GridViewColumn>
                                <GridViewColumn Width="90" DisplayMemberBinding="{Binding ItemCountDisplay}">
                                    <GridViewColumnHeader Content="{Binding FolderManager.ItemsHeader}" Style="{StaticResource SortableFolderHeader}"
                                                          Command="{Binding FolderManager.SortByCommand}" CommandParameter="Items"
                                                          ToolTip="Click to sort by number of files"/>
                                </GridViewColumn>
                                <GridViewColumn Header="" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconChip}" ctl:Icon.Data="{StaticResource Icon.Close}" Foreground="{StaticResource Ink.Red}" Margin="0"
                                                    Command="{Binding DataContext.FolderManager.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Remove this folder from the list (no files are deleted)"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconTilePrimary}" ctl:Icon.Data="{StaticResource Icon.AddFolder}" Foreground="{StaticResource Ink.Amber}"
                                    Command="{Binding AddFolderCommand}"
                                    ToolTip="Add folders: select one or more folders to add at once"/>
                            <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.SubFolders}" Foreground="{StaticResource Ink.Amber}" Margin="8,0,0,0"
                                    ToolTip="Add all subfolders: pick a parent folder and add each of its subfolders as a separate folder"
                                    Command="{Binding FolderManager.AddSubfoldersCommand}"/>
                            <Border Width="1" Background="{StaticResource Border}" Margin="12,2,12,2"/>
                            <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.Changed}" Foreground="{StaticResource Ink.Sky}"
                                    ToolTip="Only changed: tick just the folders modified since the app was last opened and untick the others"
                                    Command="{Binding FolderManager.SelectOnlyChangedCommand}"/>
                            <CheckBox Content="Auto on open" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="12,0,0,0"
                                      ToolTip="When the app opens, automatically tick only the folders changed since the previous opening"
                                      IsChecked="{Binding FolderManager.AutoSelectChangedOnOpen}"/>
                            <TextBlock Text="{Binding FolderManager.ChangedSummary}" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <!-- "Add all subfolders" picker: the parent's subfolders, all checked; the ones
             already in the list are greyed out. -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#B3000000"
                Visibility="{Binding FolderManager.IsSubfolderPickerOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="20,16" Width="560" MaxHeight="560"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <Run Text="Add subfolders of "/><Run Text="{Binding FolderManager.SubfolderRoot, Mode=OneWay}"/>
                    </TextBlock>
                    <StackPanel Grid.Row="1" Margin="0,4,0,10">
                        <TextBlock Text="{Binding FolderManager.SubfolderSummary}" Foreground="{StaticResource TextMuted}" FontSize="11.5"/>
                        <CheckBox Content="Select all" Foreground="{StaticResource Text}" FontWeight="SemiBold" Margin="0,10,0,0" ToolTip="Check or uncheck every subfolder that is not already in the list"
                                  IsChecked="{Binding FolderManager.AllSubfoldersChecked}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MinHeight="60">
                        <ItemsControl ItemsSource="{Binding FolderManager.SubfolderCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="18,3,0,3">
                                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanToggle}" ToolTip="Add this subfolder to the list"
                                                  Content="{Binding DisplayName}" Foreground="{StaticResource Text}"/>
                                        <TextBlock Text="  · already in the list" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                                   Visibility="{Binding IsAlreadyAdded, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <CheckBox Grid.Row="3" Content="Also include deeper levels (subfolders of subfolders)" Margin="0,10,0,0" ToolTip="Also list the subfolders inside each subfolder"
                              Foreground="{StaticResource Text}" IsChecked="{Binding FolderManager.IncludeDeeperLevels}"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Style="{StaticResource IconTile}" ctl:Icon.Data="{StaticResource Icon.Close}" Foreground="{StaticResource Ink.Red}"
                                Command="{Binding FolderManager.CancelSubfoldersCommand}"
                                ToolTip="Cancel: add nothing"/>
                        <Button Style="{StaticResource IconTilePrimary}" ctl:Icon.Data="{StaticResource Icon.Check}" Foreground="{StaticResource Ink.Green}" Margin="8,0,0,0"
                                Command="{Binding FolderManager.ConfirmSubfoldersCommand}"
                                ToolTip="{Binding FolderManager.AddSubfoldersLabel}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- "Thinking" overlay: generic — shown while IsProcessing is true, for any slow
             filter/results action (today: the thumbnail-similarity sort, since ORB
             matching can take a moment). No click-to-close — it clears itself
             automatically as soon as the action finishes. -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#B3000000"
                Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="26,20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentStrong}" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SortPulseStoryboard">
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.35" Duration="0:0:0.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SortPulseStoryboard"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ProcessingMessage}" FontWeight="Bold" Foreground="{StaticResource Text}" FontSize="13" VerticalAlignment="Center"/>
                    <Button Content="Cancel" Style="{StaticResource PillDanger}" Margin="18,0,0,0" VerticalAlignment="Center"
                            Command="{Binding CancelProcessingCommand}"
                            Visibility="{Binding IsProcessingCancellable, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
