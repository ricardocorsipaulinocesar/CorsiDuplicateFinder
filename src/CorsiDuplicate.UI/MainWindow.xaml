<Window x:Class="CorsiDuplicate.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CorsiDuplicate.UI"
        xmlns:vm="clr-namespace:CorsiDuplicate.UI.ViewModels"
        xmlns:conv="clr-namespace:CorsiDuplicate.UI.Converters"
        mc:Ignorable="d"
        Title="Duplicate Finder" Height="720" Width="1180"
        Icon="app.ico"
        Background="#15171C">
    <Window.Resources>
        <!-- Dark theme palette -->
        <SolidColorBrush x:Key="BgApp" Color="#15171C"/>
        <SolidColorBrush x:Key="Surface" Color="#1E2128"/>
        <SolidColorBrush x:Key="SurfaceAlt" Color="#252932"/>
        <SolidColorBrush x:Key="Border" Color="#333844"/>
        <SolidColorBrush x:Key="BorderStrong" Color="#454C5B"/>
        <SolidColorBrush x:Key="Text" Color="#E8EAEF"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9AA1AD"/>
        <SolidColorBrush x:Key="Accent" Color="#6690F2"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#25324F"/>
        <SolidColorBrush x:Key="AccentStrong" Color="#8CAAF5"/>
        <SolidColorBrush x:Key="Success" Color="#3FCA80"/>
        <SolidColorBrush x:Key="SuccessSoft" Color="#1E3327"/>
        <SolidColorBrush x:Key="Danger" Color="#EA6F64"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#3A2426"/>

        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:BoolToDoubleConverter x:Key="ChevronAngle" TrueValue="90" FalseValue="0"/>
        <conv:InverseBooleanConverter x:Key="InverseBool"/>
        <conv:StringToBrushConverter x:Key="StringToBrush"/>
        <conv:RowHeightFromThumbConverter x:Key="RowHeightFromThumb"/>

        <Style TargetType="Thumb" x:Key="ColumnResizeThumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" HorizontalAlignment="Right" Width="8">
                            <Rectangle Width="2" Fill="{StaticResource BorderStrong}" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="ToolButton">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Button" x:Key="HqButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Success}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Button" x:Key="LqButton" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Danger}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style TargetType="Button" x:Key="MiniButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- toolbar -->
            <RowDefinition Height="Auto"/> <!-- scan progress hairline -->
            <RowDefinition Height="Auto"/> <!-- folder panel -->
            <RowDefinition Height="*"/>    <!-- results -->
            <RowDefinition Height="Auto"/> <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Scan folders" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ScanCommand}" IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"/>
                <Button Content="Stop scan" Style="{StaticResource DangerButton}" Margin="8,0,0,0"
                        Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}"/>
                <Border Width="1" Background="{StaticResource Border}" Margin="10,2"/>

                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="10,5" MinWidth="260">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SIMILARITY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="SimSlider" Minimum="60" Maximum="100" Width="140" VerticalAlignment="Center"
                                Value="{Binding SimilarityThreshold, Mode=TwoWay}"/>
                        <TextBlock Text="{Binding SimilarityThreshold, StringFormat={}{0:0}%}" FontWeight="Bold" Foreground="{StaticResource AccentStrong}" Width="40" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Width="1" Background="{StaticResource Border}" Margin="10,2"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="4,0"/>

                <Button Content="Delete selected" Style="{StaticResource DangerButton}" HorizontalAlignment="Right"
                        Command="{Binding DeleteSelectedCommand}" Margin="16,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Scan progress: a thin hairline, visible only while a scan is running. -->
        <ProgressBar Grid.Row="1" Height="3" BorderThickness="0" Background="{StaticResource Border}" Foreground="{StaticResource Accent}"
                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Minimum="0" Maximum="{Binding ScanProgressTotal}" Value="{Binding ScanProgressCurrent}"/>

        <!-- Folder manager panel -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MANAGED FOLDERS" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="7,1" Margin="8,0">
                            <TextBlock Text="{Binding FolderManager.Folders.Count}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentStrong}"/>
                        </Border>
                        <Button Content="+ Add folder" Style="{StaticResource ToolButton}" Padding="8,3"
                                Command="{Binding AddFolderCommand}" Margin="8,0,0,0"
                                ToolTip="Select one or more folders to add at once"/>
                        <Button Content="Hide/Show" Style="{StaticResource ToolButton}" Padding="8,3"
                                Command="{Binding FolderManager.ToggleManageFoldersCommand}" Margin="6,0,0,0"
                                ToolTip="Open the full-screen managed-folders list"/>

                        <Border Width="1" Background="{StaticResource Border}" Margin="10,2" Height="20"/>
                        <Button Content="High quality (all)" Style="{StaticResource HqButton}" Padding="8,3"
                                Command="{Binding ApplyHighQualityToAllCommand}"
                                ToolTip="In every duplicate set across every folder, keep only the best copy unchecked"/>
                        <Button Content="Low quality (all)" Style="{StaticResource LqButton}" Padding="8,3" Margin="6,0,0,0"
                                Command="{Binding ApplyLowQualityToAllCommand}"
                                ToolTip="In every duplicate set across every folder, keep only the worst copy unchecked"/>
                        <Button Content="Clean results" Style="{StaticResource ToolButton}" Padding="8,3" Margin="6,0,0,0"
                                Command="{Binding ClearResultsCommand}"
                                ToolTip="Clear every duplicate set currently shown, without re-scanning"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Results: one collapsible node per folder -->
        <ScrollViewer Grid.Row="3" Padding="16" VerticalScrollBarVisibility="Auto" Background="{StaticResource BgApp}">
            <StackPanel>
                <TextBlock Text="No duplicates found yet. Add a folder above and click Scan folders."
                           Visibility="{Binding HasAnyResults, Converter={StaticResource BoolToVisInverted}}"
                           Foreground="{StaticResource TextMuted}" Margin="8,40" HorizontalAlignment="Center" FontSize="13"/>

                <ItemsControl ItemsSource="{Binding FolderResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <!-- Folder node header: click anywhere to toggle expand/collapse -->
                                    <Border Background="{StaticResource SurfaceAlt}" Padding="12,10" Cursor="Hand"
                                            CornerRadius="8,8,0,0"
                                            MouseLeftButtonUp="FolderHeader_MouseLeftButtonUp">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#9656;" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource ChevronAngle}}"/>
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Path}" FontWeight="Bold" Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center"/>
                                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <Run Text="{Binding FileCount, Mode=OneWay}"/>
                                                <Run Text=" files scanned"/>
                                            </TextBlock>
                                            <Border Background="{StaticResource AccentSoft}" BorderThickness="0" CornerRadius="10" Padding="8,1" Margin="10,0,0,0">
                                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentStrong}">
                                                    <Run Text="{Binding Groups.Count, Mode=OneWay}"/>
                                                    <Run Text=" duplicate set(s)"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="10,10,10,10">
                                        <ItemsControl ItemsSource="{Binding Groups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <Border Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="10,6" CornerRadius="8,8,0,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="8,1" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding SetLabel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentStrong}"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding SetMeta}" Foreground="{StaticResource TextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                                                                      HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                                                      GridLinesVisibility="Horizontal" IsReadOnly="False"
                                                                      Background="{StaticResource Surface}" Foreground="{StaticResource Text}"
                                                                      BorderThickness="0" RowBackground="{StaticResource Surface}"
                                                                      HorizontalGridLinesBrush="{StaticResource Border}"
                                                                      RowHeight="{Binding DataContext.ThumbnailColumnWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RowHeightFromThumb}}"
                                                                      EnableRowVirtualization="True" HorizontalScrollBarVisibility="Auto"
                                                                      PreviewMouseWheel="ResultsDataGrid_PreviewMouseWheel">
                                                                <DataGrid.Resources>
                                                                    <Style TargetType="DataGridColumnHeader">
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                                        <Setter Property="Padding" Value="8,6"/>
                                                                    </Style>
                                                                </DataGrid.Resources>
                                                                <DataGrid.RowStyle>
                                                                    <Style TargetType="DataGridRow">
                                                                        <Setter Property="Background" Value="{Binding HashGroupColor, Converter={StaticResource StringToBrush}}"/>
                                                                    </Style>
                                                                </DataGrid.RowStyle>
                                                                <DataGrid.CellStyle>
                                                                    <Style TargetType="DataGridCell">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="BorderThickness" Value="0"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                                    </Style>
                                                                </DataGrid.CellStyle>
                                                                <DataGrid.Columns>
                                                                    <DataGridTemplateColumn Header="" Width="34">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>

                                                                    <DataGridTemplateColumn>
                                                                        <DataGridTemplateColumn.HeaderTemplate>
                                                                            <DataTemplate>
                                                                                <Grid>
                                                                                    <TextBlock Text="Thumb" VerticalAlignment="Center"/>
                                                                                    <Thumb Style="{StaticResource ColumnResizeThumb}" HorizontalAlignment="Right"
                                                                                           DragDelta="ThumbnailResizeThumb_DragDelta"/>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.HeaderTemplate>
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="{StaticResource SurfaceAlt}" CornerRadius="4" Margin="4"
                                                                                        Width="{Binding DataContext.ThumbnailColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        Height="{Binding DataContext.ThumbnailColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                        Cursor="Hand"
                                                                                        MouseLeftButtonUp="ThumbnailBorder_MouseLeftButtonUp">
                                                                                    <Grid>
                                                                                        <Image Source="{Binding Thumbnail}"
                                                                                               Stretch="Uniform"
                                                                                               Width="{Binding DataContext.ThumbnailColumnWidth, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                                        <Border Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                                                                                                Background="#33000000">
                                                                                            <TextBlock Text="▶" Foreground="White" FontSize="20"
                                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding DurationDisplay}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVis}}"
                                                                                                   Foreground="White" Background="#99000000" FontSize="10" Padding="3,1"
                                                                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="2"/>
                                                                                    </Grid>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>

                                                                    <DataGridTemplateColumn Header="File" Width="2*">
                                                                        <DataGridTemplateColumn.CellTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"/>
                                                                                    <TextBlock Text="{Binding FolderPath}" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>
                                                                    </DataGridTemplateColumn>
                                                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80" IsReadOnly="True"/>
                                                                    <DataGridTextColumn Header="Length" Binding="{Binding DurationDisplay}" Width="60" IsReadOnly="True"/>
                                                                    <DataGridTextColumn Header="Resolution" Binding="{Binding ResolutionDisplay}" Width="90" IsReadOnly="True"/>
                                                                    <DataGridTextColumn Header="Bit rate" Binding="{Binding BitRateDisplay}" Width="80" IsReadOnly="True"/>
                                                                    <DataGridTextColumn Header="Audio" Binding="{Binding AudioDisplay}" Width="80" IsReadOnly="True"/>
                                                                    <DataGridTextColumn Header="Match" Binding="{Binding MatchDisplay}" Width="70" IsReadOnly="True"/>
                                                                    <DataGridTextColumn Header="Hash" Binding="{Binding HashHex}" Width="110" IsReadOnly="True"/>
                                                                </DataGrid.Columns>
                                                            </DataGrid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="Black" FontSize="15" Foreground="{StaticResource AccentStrong}" Text="{Binding Selection.SelectedCount}"/>
                <TextBlock Text=" selected" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,16,1"/>
                <TextBlock FontWeight="Black" FontSize="15" Foreground="{StaticResource AccentStrong}" Text="{Binding Selection.TotalSelectedDisplay}"/>
                <TextBlock Text=" total size" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
            </StackPanel>
        </Border>

        <!-- Managed folders: full-screen overlay. Covers every row so it sits above the
             whole window; clicking the dark backdrop closes it, clicking the sheet itself
             does not (the sheet's own MouseLeftButtonDown is marked handled below). -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#B3000000"
                Visibility="{Binding FolderManager.IsManageFoldersOpen, Converter={StaticResource BoolToVis}}"
                MouseLeftButtonDown="ManageFoldersBackdrop_MouseLeftButtonDown">
            <Border Background="{StaticResource BgApp}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Margin="28" MouseLeftButtonDown="ManageFoldersSheet_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="20,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Managed folders" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5">
                                        <Run Text="{Binding FolderManager.Folders.Count, Mode=OneWay}"/>
                                        <Run Text=" folder(s) tracked · click outside this panel to close"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="&#10005;" Style="{StaticResource MiniButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding FolderManager.CloseManageFoldersCommand}"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding FolderManager.Folders}" BorderThickness="0" Background="{StaticResource BgApp}">
                        <ListView.Resources>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="Background" Value="{StaticResource SurfaceAlt}"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="On" Width="40">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Folder path" Width="560" DisplayMemberBinding="{Binding Path}"/>
                                <GridViewColumn Header="Last scanned" Width="150" DisplayMemberBinding="{Binding LastScannedDisplay}"/>
                                <GridViewColumn Header="Items" Width="100" DisplayMemberBinding="{Binding ItemCountDisplay}"/>
                                <GridViewColumn Header="" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remove" Style="{StaticResource MiniButton}"
                                                    Command="{Binding DataContext.FolderManager.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                            BorderThickness="0,1,0,0" CornerRadius="0,0,10,10" Padding="20,12">
                        <Button Content="+ Add folder" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                                Command="{Binding AddFolderCommand}"/>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
