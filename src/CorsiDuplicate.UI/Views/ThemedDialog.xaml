<Window x:Class="CorsiDuplicate.UI.Views.ThemedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" MinWidth="380" MaxWidth="560" MaxHeight="620"
        FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Flat rounded button; hover lightens, press darkens (the stock template turns light blue). -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Same palette as the main window: Surface card, Border outline, accent button. -->
    <Border Margin="14" Background="#1E2128" BorderBrush="#454C5B" BorderThickness="1" CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,18,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="Dot" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Fill="#6690F2"/>
                <TextBlock x:Name="TitleText" Grid.Column="1" Foreground="#E8EAEF" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="22,12,22,0">
                <TextBlock x:Name="MessageText" Foreground="#C9CED8" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,18,22,18">
                <Button x:Name="SecondaryButton" Click="Secondary_Click" Margin="0,0,8,0" MinWidth="84" Padding="14,7"
                        Foreground="#E8EAEF" Background="#252932" BorderBrush="#454C5B" BorderThickness="1" Cursor="Hand"/>
                <Button x:Name="PrimaryButton" Click="Primary_Click" IsDefault="True" MinWidth="84" Padding="14,7"
                        Foreground="White" Background="#6690F2" BorderBrush="#6690F2" BorderThickness="1"
                        FontWeight="SemiBold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
