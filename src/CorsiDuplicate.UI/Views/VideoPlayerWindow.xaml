<Window x:Class="CorsiDuplicate.UI.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title, RelativeSource={RelativeSource Self}}"
        Width="760" Height="520" Background="Black"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <MediaElement x:Name="Player" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                      Stretch="Uniform" MediaOpened="Player_MediaOpened"/>

        <StackPanel Grid.Row="1" Background="#222" Margin="0">
            <Grid Margin="12,10,12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" Grid.Column="0" Text="0:00" Foreground="White" VerticalAlignment="Center" Width="42"/>
                <Slider x:Name="Scrubber" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"
                        PreviewMouseDown="Scrubber_PreviewMouseDown" PreviewMouseUp="Scrubber_PreviewMouseUp"
                        ValueChanged="Scrubber_ValueChanged"/>
                <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="White" VerticalAlignment="Center" Width="42" TextAlignment="Right"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button Content="◀◀ 10s" Width="70" Margin="6,0" Click="SeekBack_Click"/>
                <Button x:Name="PlayPauseButton" Content="Pause" Width="70" Margin="6,0" Click="PlayPauseButton_Click"/>
                <Button Content="10s ▶▶" Width="70" Margin="6,0" Click="SeekForward_Click"/>
                <Button Content="Restart" Width="70" Margin="6,0" Click="RestartButton_Click"/>
                <Button Content="Close" Width="70" Margin="6,0" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
