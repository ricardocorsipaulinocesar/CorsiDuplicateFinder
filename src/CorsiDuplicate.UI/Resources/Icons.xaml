    <!-- One ink colour per function, as in CorsiRemote (hue by role). -->
    <SolidColorBrush x:Key="Ink.Blue" Color="#679BE4"/>
    <SolidColorBrush x:Key="Ink.Sky" Color="#67BBE4"/>
    <SolidColorBrush x:Key="Ink.Cyan" Color="#67CFE4"/>
    <SolidColorBrush x:Key="Ink.Violet" Color="#9567E4"/>
    <SolidColorBrush x:Key="Ink.Amber" Color="#E4BB67"/>
    <SolidColorBrush x:Key="Ink.Green" Color="#67E4A6"/>
    <SolidColorBrush x:Key="Ink.Red" Color="#E47067"/>
    <SolidColorBrush x:Key="Ink.Pink" Color="#E467A6"/>


    <LinearGradientBrush x:Key="IconTileBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#242D3A" Offset="0"/>
        <GradientStop Color="#181F28" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IconTileHotBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C3746" Offset="0"/>
        <GradientStop Color="#1D2530" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IconTilePrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2F5F8A" Offset="0"/>
        <GradientStop Color="#1B3A55" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="IconTileSelectedBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C3F6B" Offset="0"/>
        <GradientStop Color="#1D2A4A" Offset="1"/>
    </LinearGradientBrush>

    <!-- Square relief button with only an icon (CorsiRemote look): dark tile with a soft
         shadow at the bottom right, the glyph in the function's colour. Every use sets a
         ToolTip; disabled tiles are dimmed but keep showing their tip. -->
    <Style x:Key="IconTile" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="Foreground" Value="{StaticResource Ink.Blue}"/>
        <Setter Property="Background" Value="{StaticResource IconTileBrush}"/>
        <Setter Property="BorderBrush" Value="#1CFFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="250"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" CornerRadius="9" Background="#99050810" Margin="2,2,0,0"/>
                        <Border x:Name="Tile" CornerRadius="9" Margin="0,0,2,2" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Viewbox Margin="{TemplateBinding Padding}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding (ctl:Icon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource IconTileHotBrush}"/>
                            <Setter TargetName="Tile" Property="BorderBrush" Value="#37FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tile" Property="Margin" Value="2,2,0,0"/>
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="#8CAAF5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconTilePrimary" TargetType="Button" BasedOn="{StaticResource IconTile}">
        <Setter Property="Background" Value="{StaticResource IconTilePrimaryBrush}"/>
    </Style>

    <!-- Same tile, smaller: the sort chips of a folder and the row buttons of the lists. -->
    <Style x:Key="IconChip" TargetType="Button" BasedOn="{StaticResource IconTile}">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Shadow" CornerRadius="7" Background="#99050810" Margin="1,1,0,0"/>
                        <Border x:Name="Tile" CornerRadius="7" Margin="0,0,1,1" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Viewbox Margin="{TemplateBinding Padding}">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding (ctl:Icon.Data), RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource IconTileHotBrush}"/>
                            <Setter TargetName="Tile" Property="BorderBrush" Value="#37FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Tile" Property="Margin" Value="1,1,0,0"/>
                            <Setter TargetName="Shadow" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
